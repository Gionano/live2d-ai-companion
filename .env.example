# Backend environment names only. Copy to .env and supply your own values.
# Assign profiles and models in ignored providers.config.local.json first.
# Public provider profiles are templates; every slot starts unassigned.
PROVIDER_API_KEY=

# Main chat, memory extraction and selfie planner.
EXPLABS_API_KEY=
# Legacy names only work when explicitly referenced by a configured shared profile/slot.
# Environment variables alone never assign a slot; local configuration takes precedence.
EXPLABS_BASE_URL=
EXPLABS_MODEL=

# Continuous-vision filter and its warm-up/keep-alive.
NINEINFERENCE_API_KEY=

# Vision and speech recognition.
GROQ_API_KEY=
# Legacy origin override requires an explicit baseUrlEnv/baseUrlEnvSuffix mapping.
GROQ_BASE_URL=

# Fish Audio speech synthesis.
FISH_API_KEY=

# ElevenLabs speech synthesis. Assign an ElevenLabs profile and Voice ID first.
ELEVENLABS_API_KEY=

# Optional Cloudflare PAP credentials. Select Cloud in Foto / PAP settings.
# Environment tokens override the token saved in the encrypted settings store.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional Anthropic profile: set apiKeyEnv to this name in local provider config.
ANTHROPIC_API_KEY=

# Optional backend port; default 8787.
PORT=

# Optional memory storage directory; default is the repository data/ directory.
WAIFU_DATA_DIR=
