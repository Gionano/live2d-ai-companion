# ---------------------------------------------------------------------------
# Environment Variables Example for Amika Live2D Companion
# Copy file ini menjadi `.env` lalu isi dengan API key Anda.
# ---------------------------------------------------------------------------

# 9inference — dipakai untuk LLM Chat (DeepSeek V4 Flash)
# Dapatkan di: https://9inference.cloud
NINEINFERENCE_API_KEY=your_9inference_key_here

# Groq — dipakai untuk STT (Whisper Large v3) DAN Vision (Qwen 3.8 27B)
# Satu API key mencakup kedua model. Dapatkan di: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Fish Audio — dipakai untuk Text-to-Speech streaming suara waifu
# Dapatkan di: https://fish.audio (API keys)
FISH_API_KEY=your_fish_key_here

# Port Server Express / WebSocket backend (default: 8787)
PORT=8787
