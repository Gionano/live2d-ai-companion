{
  "name": "amika-live2d-companion",
  "description": "Amika AI companion with official Live2D Cubism Web rendering, STT, LLM, and TTS",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "test": "node scripts/runTests.js",
    "check:privacy": "node scripts/checkPrivacy.js",
    "providers:test": "node server/providers/cli.js",
    "tts:try": "node server/ttsTry.js",
    "settings:doctor": "node server/settings/doctorCli.js",
    "selfie:test": "node server/selfie/selfieTest.js",
    "selfie:test-b": "node scripts/runTests.js server/tests/planner.test.js",
    "selfie:test-c": "node scripts/runTests.js server/tests/jobManager.test.js",
    "selfie:plan": "node server/selfie/selfiePlanTest.js",
    "setup:plan": "node setup/cli.js plan",
    "setup:models": "node setup/cli.js models",
    "setup:sdcli": "node setup/cli.js sdcli",
    "setup:comfyui": "node setup/cli.js comfyui",
    "setup:hash": "node setup/cli.js hash",
    "doctor": "node setup/cli.js doctor",
    "dev:all": "concurrently -k -n server,vite -c yellow,cyan \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "adm-zip": "^0.6.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "simplex-noise": "^4.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  }
}
