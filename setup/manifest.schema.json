{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified local engine and model downloads (v1 compatibility, v2 typed variants)",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "components"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "components": {
          "$ref": "#/$defs/components1"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "components"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 2
        },
        "components": {
          "$ref": "#/$defs/components2"
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "component1": {
      "type": "object",
      "required": [
        "name",
        "url",
        "sha256",
        "sizeBytes",
        "licenseName",
        "licenseUrl",
        "kind",
        "destination",
        "required"
      ],
      "anyOf": [
        {
          "required": [
            "version"
          ]
        },
        {
          "required": [
            "commit"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "licenseName": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![/\\\\]|[a-zA-Z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "required": {
          "type": "boolean"
        },
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "comfyui",
              "sdcpp"
            ]
          }
        },
        "role": {
          "enum": [
            "diffusion",
            "vae",
            "text_encoder",
            "vision_projector",
            "node",
            "runtime",
            "runtime_library"
          ]
        },
        "when": {
          "type": "object",
          "required": [
            "gpuVendor",
            "os"
          ],
          "properties": {
            "gpuVendor": {
              "enum": [
                "nvidia",
                "any"
              ]
            },
            "os": {
              "const": "win32"
            }
          },
          "additionalProperties": false
        },
        "variant": {
          "enum": [
            "cuda12",
            "vulkan"
          ]
        }
      },
      "additionalProperties": false
    },
    "component2": {
      "type": "object",
      "required": [
        "name",
        "url",
        "sha256",
        "sizeBytes",
        "licenseName",
        "licenseUrl",
        "kind",
        "destination",
        "required",
        "engines",
        "role",
        "when"
      ],
      "anyOf": [
        {
          "required": [
            "version"
          ]
        },
        {
          "required": [
            "commit"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "licenseName": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![/\\\\]|[a-zA-Z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "required": {
          "type": "boolean"
        },
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "comfyui",
              "sdcpp"
            ]
          }
        },
        "role": {
          "enum": [
            "diffusion",
            "vae",
            "text_encoder",
            "vision_projector",
            "node",
            "runtime",
            "runtime_library"
          ]
        },
        "when": {
          "type": "object",
          "required": [
            "gpuVendor",
            "os"
          ],
          "properties": {
            "gpuVendor": {
              "enum": [
                "nvidia",
                "any"
              ]
            },
            "os": {
              "const": "win32"
            }
          },
          "additionalProperties": false
        },
        "variant": {
          "enum": [
            "cuda12",
            "vulkan"
          ]
        }
      },
      "additionalProperties": false
    },
    "components1": {
      "type": "object",
      "required": [
        "comfyui-portable",
        "comfyui-gguf-node",
        "sd-cli",
        "cudart",
        "models"
      ],
      "properties": {
        "7zip-extractor": {
          "$ref": "#/$defs/component1"
        },
        "comfyui-portable": {
          "$ref": "#/$defs/component1"
        },
        "comfyui-gguf-node": {
          "$ref": "#/$defs/component1"
        },
        "sd-cli": {
          "$ref": "#/$defs/component1"
        },
        "cudart": {
          "$ref": "#/$defs/component1"
        },
        "constraints": {
          "$ref": "#/$defs/component1"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component1"
          }
        }
      },
      "additionalProperties": false
    },
    "components2": {
      "type": "object",
      "required": [
        "comfyui-portable",
        "comfyui-gguf-node",
        "sd-cli",
        "cudart",
        "models"
      ],
      "properties": {
        "7zip-extractor": {
          "$ref": "#/$defs/component2"
        },
        "comfyui-portable": {
          "$ref": "#/$defs/component2"
        },
        "comfyui-gguf-node": {
          "$ref": "#/$defs/component2"
        },
        "sd-cli": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/component2"
              },
              {
                "required": [
                  "variant"
                ]
              }
            ]
          }
        },
        "cudart": {
          "$ref": "#/$defs/component2"
        },
        "constraints": {
          "$ref": "#/$defs/component2"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component2"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
