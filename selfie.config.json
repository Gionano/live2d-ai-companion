{
  "_comment": "Selfie tuning constants. Read only by the backend.",
  "provider": "auto",
  "autoOrder": [
    "comfyui",
    "comfyui-managed",
    "sdcpp"
  ],
  "availabilityCacheMs": 30000,
  "healthTimeoutMs": 1500,
  "comfyUrl": "http://127.0.0.1:8188",
  "outputDir": "${LOCAL}/outputs",
  "autoCloseSeconds": 30,
  "allowLan": false,
  "filenamePrefix": "waifu_selfie",
  "jobTimeoutMs": 600000,
  "freeVramAfter": true,
  "maxQueue": 1,
  "cooldownMs": 60000,
  "dailyLimit": 20,
  "preset": "cepat",
  "presets": {
    "cepat": {
      "resolution": 768,
      "steps": 12,
      "cfg": 3
    },
    "kualitas": {
      "resolution": 1024,
      "steps": 20,
      "cfg": 3
    },
    "hemat": {
      "resolution": 768,
      "steps": 12,
      "cfg": 3,
      "sdcpp": {
        "args": [],
        "modelArgs": []
      }
    }
  },
  "referenceDir": "assets/references",
  "defaultReference": "default.jpg",
  "workflowFile": "workflows/selfie.api.json",
  "mappingFile": "selfie.mapping.json",
  "keywordsFile": "config/selfieKeywords.json",
  "characterCardFile": "config/characterCard.json",
  "moderationFile": "config/selfieModeration.json",
  "plannerTimeoutMs": 20000,
  "pollIntervalMs": 1500,
  "cacheRetries": 1,
  "etaHistorySize": 5,
  "etaStoreFile": "data/selfie-durations.json",
  "limitsStoreFile": "data/selfie-limits.json",
  "logFile": "${LOCAL}/logs/selfie.log",
  "telemetry": {
    "enabled": true,
    "intervalMs": 2000,
    "probeTimeoutMs": 1500
  },
  "comfyuiManaged": {
    "installDir": "",
    "pythonPath": "",
    "mainScript": "",
    "host": "127.0.0.1",
    "port": "auto",
    "args": [],
    "env": {},
    "startTimeoutMs": 120000,
    "idleStopSeconds": 90,
    "healthPath": "/system_stats",
    "profiles": {},
    "profile": ""
  },
  "phrases": {
    "initial": [
      "Tunggu ya sayang, aku pose dulu sebentar...",
      "Bentar ya sayang, aku siap-siap foto dulu yaa~"
    ],
    "busy": [
      "Masih fotoin yang tadi ya sayang, tunggu sebentar yaa~",
      "Foto yang tadi masih diproses nih sayang, sabar yaa~"
    ],
    "cooldown": [
      "Baru aja selesai foto nih sayang, bentar ya napas dulu sebentar~",
      "Tunggu sebentar ya sayang, baru aja selesai foto tadi kok~"
    ],
    "dailyLimit": [
      "Wah hari ini udah banyak banget fotonya sayang, besok lagi yaa~",
      "Kamera aku istirahat dulu ya sayang, kuota foto hari ini udah habis deh~"
    ],
    "providerUnavailable": [
      "Aduh sayang, sekarang aku belum bisa foto. Studio gambarku belum siap nih.",
      "Maaf ya sayang, kamera digitalku belum bisa dipakai sekarang."
    ],
    "failed": [
      "Yah sayang, fotonya gagal diproses nih. Nanti kita coba lagi yaa.",
      "Aduh maaf ya sayang, tadi ada kendala pas memproses fotonya."
    ],
    "cancelled": [
      "Oke sayang, pengambilan fotonya sudah aku batalkan yaa."
    ]
  },
  "sdcpp": {
    "binaryPath": "",
    "diffusionModel": "${LOCAL}/models/diffusion_models/qwen-image-2.1-UC-Q5_K_M.gguf",
    "vae": "${LOCAL}/models/vae/qwen_image_2.1_vae_bf16.safetensors",
    "llm": "${LOCAL}/models/text_encoders/Qwen3VL-8B-Instruct-Q4_K_M.gguf",
    "llmVision": "${LOCAL}/models/text_encoders/mmproj-Qwen3VL-8B-Instruct-F16.gguf",
    "offloadToCpu": true,
    "allowCpu": false,
    "forceRun": false,
    "args": [
      "--sampling-method",
      "euler",
      "--offload-to-cpu"
    ],
    "modelArgs": [],
    "extraArgs": [],
    "helpTimeoutMs": 5000,
    "deviceTimeoutMs": 5000,
    "stderrTailBytes": 8192
  }
}
